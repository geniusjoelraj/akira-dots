;; ================= music-widget ======================

(defwindow music-widget
  :monitor 0
  :stacking "fg"
  :geometry (
    geometry :x "1070px" 
             :y "5px" 
             :width "200px" 
             :height "120px"
  )
  (music-widget)
)

(defwindow time_widget_top_left
  :stacking "bg"
  :monitor 0
  :geometry (
   geometry :y "0px"
            :x "-60px"
            :width "800px"
            :height "200px"
  )
  (time)
)

