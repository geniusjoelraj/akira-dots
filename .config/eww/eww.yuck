;;================ calendar ==================

(defwindow calendar
    :monitor 0
    :stacking "fg"
    :geometry (geometry
		:x "46%"
		:y "0px"
        :width "15%"
    	:anchor "top left"
    )
    (calendar_layout)
)

(defwidget calendar_layout []
	(box :class "calendar_layout_box"
		:orientation "vertical"
		:space-evenly false
		:spacing 15
		(cal_time)
		(_calendar)
		;; (_weather)
	)
)

