(deflisten song_title    :initial "No Music Playing"
"playerctl metadata -p spotify --format {{title}} --follow || echo 'No Music Playing'")

(deflisten song_artist   :initial "Unknown Artist"
"playerctl metadata -p spotify --format {{artist}} --follow || echo 'Unknown Artist'")

(deflisten player_status :initial "Stopped"
"playerctl metadata -p spotify --format {{status}} --follow || echo 'Stopped'")

(defpoll cover_art_path :interval "5s" 
"~/.scripts/get_spotify_art.sh")

(defwidget music-widget []
  (box :class "music-widget" :orientation "h" :space-evenly false :hexpand false :vexpand: false :border-radius 10 :valign "center" :halign "center"
    (box :class "cover-art" :style "background-image: url('${cover_art_path}');")
    (box :class "music-info" :orientation "v" :space-evenly false :halign "center" :valign "center" :width 200 :height 100 
    (box :orientation "v" :halign: "center" :valign "center"
      (label :class "song-title" :text song_title )
      (label :class "artist" :text song_artist )
    )
      (box :class "controls" :orientation "h" :halign: "center" :valign "center" :width 200 :hexpand false :vexpand false :space-evenly false
        (button :onclick "playerctl previous -p spotify" "")
        (button :onclick "playerctl play-pause -p spotify" {player_status == "Playing" ? "" : ""})
        (button :onclick "playerctl next -p spotify" "")
       )
      
    )
  )
)
