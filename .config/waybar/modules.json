{
  "hyprland/workspaces": {
    "rotate": 0,
    "all-outputs": true,
    "active-only": false,
    "on-click": "activate",
    "disable-scroll": false,
    "on-scroll-up": "hyprctl dispatch workspace -1",
    "on-scroll-down": "hyprctl dispatch workspace +1",
    "format": "{icon}",
    "persistent-workspaces": {
      "*": 0
    },
    "format-icons": {
      "1": "一",
      "2": "二",
      "3": "三",
      "4": "四",
      "5": "五",
      "6": "六",
      "7": "七",
      "8": "八",
      "9": "九",
      "10": "十",
      "11": "十一",
      "12": "十二",
      "13": "十三",
      "14": "十四",
      "15": "十五",
      "16": "十六",
      "17": "十七",
      "18": "十八",
      "19": "十九",
      "20": "二十",
      "urgent": "",
      "focused": "",
      "default": " "
    },
  }, // Hyprland Window
  "hyprland/window": {
    "max-length": 30
  },
  // Rofi Application Launcher
  "custom/appmenu": {
    "format": "󰣇",
    "tooltip-format": "Left: Open the application launcher\nRight: Show all keybindings",
    "on-click": "~/.config/rofi/launchers/type-4/launcher.sh",
    "on-click-right": "~/.config/notscripter/scripts/keybindings.sh",
    "tooltip": false
  },
  // Power Menu
  "custom/exit": {
    "format": "",
    "tooltip-format": "Powermenu",
    "on-click": "wlogout -b 4",
    "tooltip": false
  },
  "custom/spotify": {
    "format": " {}",
    "exec": "playerctl -p spotifyd metadata --format '{{ artist }} - {{ title }}'",
    "interval": 0.1,
    "on-click-middle": "playerctl -p spotifyd play-pause",
    "on-click": "playerctl -p spotifyd previous",
    "on-click-right": "playerctl -p spotifyd next"
  },
  "mpris": {
    "player": "spotify",
    "on-click": "playerctl previous --player spotify",
    "on-click-middle": "playerctl play-pause --player spotify",
    "on-click-right": "playerctl next --player spotify",
    "on-scroll-up": "wpctl set-volume 109 10%+",
    "on-scroll-down": "wpctl set-volume 109 10%-",
    "max-length": 40,
    "tooltip": false,
    "format-paused": " {title} - {artist}",
    "format": " {title} - {artist}",
    "on-scroll-up": "~/.scripts/vol_app.sh spotify up",
    "on-scroll-down": "~/.scripts/vol_app.sh spotify down",
    //"dynamic-order": ["album", "length"]
  },
  "custom/notification": {
    "tooltip": false,
    //"format": "{} {icon}",
    "format": "{icon}",
    "icon-size": 14,
    "format-icons": {
      "notification": "󱅫",
      "none": "󰂚",
      "dnd-notification": "󱅫",
      "dnd-none": "󰂛",
      "inhibited-notification": "",
      "inhibited-none": "",
      "dnd-inhibited-notification": "",
      "dnd-inhibited-none": ""
    },
    "return-type": "json",
    "exec-if": "which swaync-client",
    "exec": "swaync-client -swb",
    "on-click": "swaync-client -t -sw",
    "on-click-right": "swaync-client -d -sw",
    "escape": true
  },
  // Keyboard State
  "keyboard-state": {
    "numlock": true,
    "capslock": true,
    "format": "{name} {icon}",
    "format-icons": {
      "locked": "",
      "unlocked": ""
    }
  },
  // System tray
  "tray": {
    "icon-size": 14,
    "spacing": 8
  },
  "mpd": {
    "max-length": 40,
    "tooltip": false,
    "format-paused": "󰏤 {title} - {artist}",
    "format-stopped": "  rmpc",
    "format": " {title} - {artist}",
    "on-click-right": "mpc next",
    "on-click": "kitty -e rmpc",
    "on-click-middle": "mpc toggle",
    "on-scroll-up": "~/.scripts/vol_app.sh Music up",
    "on-scroll-down": "~/.scripts/vol_app.sh Music down",
  },
  "custom/firefox": {
    "format": "󰈹",
    "on-scroll-up": "~/.scripts/vol_app.sh Firefox up",
    "on-scroll-down": "~/.scripts/vol_app.sh Firefox down",
  },
  "custom/zen": {
    "format": "󰰷 ",
    "on-scroll-up": "~/.scripts/vol_app.sh Zen up",
    "on-scroll-down": "~/.scripts/vol_app.sh Zen down",
  },
  "custom/accent": {
    "format": "",
    "tooltip": false,
    "menu": "on-click",
    "menu-file": "~/.config/waybar/accent.xml",
    "menu-actions": {
      "rosewater": "~/.scripts/accent_change rosewater",
      "flamingo": "~/.scripts/accent_change flamingo",
      "pink": "~/.scripts/accent_change pink",
      "mauve": "~/.scripts/accent_change mauve",
      "red": "~/.scripts/accent_change red",
      "maroon": "~/.scripts/accent_change maroon",
      "peach": "~/.scripts/accent_change peach",
      "yellow": "~/.scripts/accent_change yellow",
      "green": "~/.scripts/accent_change green",
      "teal": "~/.scripts/accent_change teal",
      "sky": "~/.scripts/accent_change sky",
      "sapphire": "~/.scripts/accent_change sapphire",
      "blue": "~/.scripts/accent_change blue",
      "lavender": "~/.scripts/accent_change lavender"
    }
  },
  "clock#time": {
    "format": "{:%I:%M %p}",
    "format-alt": "{:%A, %B %d, %Y}",
    //"tooltip-format": "<tt><small>{calendar}</small></tt>",
    "tooltip": false,
    "calendar": {
      "mode": "month",
      "mode-mon-col": 3,
      "weeks-pos": "right",
      "on-scroll": 1,
      "on-click-right": "mode",
      "format": {
        "months": "<span color='#ffead3'><b>{}</b></span>",
        "days": "<span color='#ecc6d9'><b>{}</b></span>",
        "weekdays": "<span color='#ffcc66'><b>{}</b></span>",
        "today": "<span color='#ff6699'><b><u>{}</u></b></span>"
      }
    },
    //"actions": {
    //	"on-click-right": "mode",
    //	"on-click-forward": "tz_up",
    //	"on-click-backward": "tz_down",
    //	"on-scroll-up": "shift_up",
    //	"on-scroll-down": "shift_down"
    //}
  },
  "hyprland/language": {
    "format": "/ K {short}"
  },
  // Network
  "network": {
    "tooltip": false,
    "format": "{ifname}",
    "format-wifi": "  {essid}",
    "format-ethernet": "   {bandwidthDownBytes}  {bandwidthUpBytes} ",
    "format-disconnected": "󰖪",
    "tooltip-format": "  {ifname} via {gwaddri}",
    "tooltip-format-wifi": "   {essid} ({signalStrength}%)",
    "tooltip-format-ethernet": "  {ifname} ({ipaddr}/{cidr})",
    "tooltip-format-disconnected": "Disconnected",
    "max-length": 50,
    "interval": 1,
    "on-click": "nm-connection-editor"
  },
  // Battery
  "battery": {
    "states": {
      "good": 95,
      "warning": 30,
      "critical": 15
    },
    "format": "{icon}",
    "format-charging": "  {capacity}%",
    "format-plugged": "  {capacity}%",
    "format-alt": "{icon} {capacity}%",
    // "format-good": "", // An empty format will hide the module
    // "format-full": "",
    "format-icons": [
      " ",
      " ",
      " ",
      " ",
      " "
    ]
  },
  "cava": {
    //        "cava_config": "$XDG_CONFIG_HOME/cava/cava.conf",
    "framerate": 30,
    "autosens": 1,
    "sensitivity": 100,
    "bars": 14,
    "lower_cutoff_freq": 50,
    "higher_cutoff_freq": 10000,
    "method": "pulse",
    "source": "auto",
    "stereo": true,
    "reverse": false,
    "bar_delimiter": 0,
    "monstercat": false,
    "waves": false,
    "noise_reduction": 0.77,
    "input_delay": 2,
    "format-icons": [
      "▁",
      "▂",
      "▃",
      "▄",
      "▅",
      "▆",
      "▇",
      "█"
    ],
    "actions": {
      "on-click-right": "mode"
    }
  },
  // Bluetooth
  "bluetooth": {
    "format-disabled": "󰂲",
    "format-connected": " ",
    "format-icons": [
      "󰥇",
      "󰤾",
      "󰤿",
      "󰥀",
      "󰥁",
      "󰥂",
      "󰥃",
      "󰥄",
      "󰥅",
      "󰥆",
      "󰥈"
    ],
    "format-off": "",
    "interval": 30,
    "on-click": "blueman-manager",
    "format-no-controller": ""
  },
  // Other
  "user": {
    "format": "{user}",
    "interval": 60,
    "icon": true
  },
  // Idle Inhibator
  "idle_inhibitor": {
    "format": "{icon} ",
    "tooltip": true,
    "format-icons": {
      "activated": "󰅶",
      "deactivated": "󰾪"
    },
    "start-activated": true
  },
  "power-profiles-daemon": {
    "format": "{icon}",
    "tooltip-format": "Power profile: {profile}\nDriver: {driver}",
    "tooltip": false,
    "format-icons": {
      "default": "",
      "performance": " ",
      "balanced": " ",
      "power-saver": " "
    }
  },
  "custom/wallpaper": {
    "format": "🖼️ {}",
    "max-length": 25,
    "interval": 10,
    "exec": "basename \"$(cat ~/.cache/swww/current_wallpaper 2>/dev/null || echo 'None')\"",
    "on-click": "~/.config/eww/scripts/toggle_wallpaper_window.sh",
    "tooltip": true,
    "tooltip-format": "Current wallpaper: {}\nClick to change wallpaper",
    "return-type": "text"
  },
}
