#!/bin/bash

# 1. Find all regular files in the specified directory (non-recursive)
# 2. Loop through each file path
# 3. Format the output for rofi: "filename<NULL>icon<UNIT_SEPARATOR>fullpath<NEWLINE>"
#    - This displays only the filename but uses the full path as the "icon" for rofi's internal selection data.
# 4. Pipe the formatted list into rofi's dmenu mode.
#    - rofi will present the filenames and return the full path associated with the selection.
# 5. The selected wallpaper path is captured by $(...) and stored in the 'wallpaper' variable.
wallpaper=$(
  ls -1t /home/tensai/Pictures/Wallpapers |
    while IFS= read -r filename; do
      full_path="/home/tensai/Pictures/Wallpapers/$filename"
      echo -en "$filename\0icon\x1f$full_path\n"
    done |
    rofi -dmenu -theme ~/.config/rofi/wall.rasi -case-smart
)

wallpaper_filename="$wallpaper"

if [[ -n "$wallpaper_filename" ]]; then
  full_path="/home/tensai/Pictures/Wallpapers/$wallpaper_filename"
  notify-send "Wallpaper changed" "$wallpaper_filename" -i "$full_path"
  swww img "$full_path" --transition-type wipe
fi
